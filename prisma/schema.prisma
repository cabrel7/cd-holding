// Prisma 7 : l'URL de connexion est dans prisma.config.ts (plus dans le datasource),
// et le client runtime passe par le driver adapter @prisma/adapter-pg (server/utils/prisma.ts).

generator client {
  provider     = "prisma-client"
  output       = "../server/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum CompanyType {
  HOLDING
  FILIALE
}

enum Role {
  SUPER_ADMIN
  ADMIN_FILIALE
  EMPLOYE
}

enum StatutClient {
  PROSPECT
  CLIENT_ACTIF
  INACTIF
}

enum StatutCandidature {
  NOUVELLE
  EN_REVISION
  RETENUE
  REJETEE
}

enum StatutReservation {
  EN_ATTENTE
  CONFIRMEE
  ANNULEE
}

enum TypeMessage {
  CONTACT
  SUGGESTION_PRODUIT
  ASSISTANT_IMPORT_EXPORT
}

// PUBLIC : images CMS affichées sur les sites publics (services, équipe, logos...).
// PRIVE  : CV, documents de candidature, pièces comptables — session + scoping filiale obligatoires.
enum VisibiliteFichier {
  PUBLIC
  PRIVE
}

// --- Phase 2 : fondations communes (nouveaux enums, spec §1.1) -------------------------

enum StatutSite {
  ACTIF
  EN_MAINTENANCE
  EN_CONSTRUCTION
}

enum PageSite {
  COMMUN
  ACCUEIL
  SERVICES
  REALISATIONS
  A_PROPOS
  CONTACT
  RESTAURANT
  OFFRES
  CONFIDENTIALITE
  MENTIONS_LEGALES
}

enum StatutMessage {
  NOUVEAU
  EN_COURS
  TRAITE
}

enum CategoriePoste {
  MANUTENTION
  CHAUFFEUR_CLASSE_1
  CHAUFFEUR_CLASSE_3
  CHAUFFEUR_CLASSE_5
  ENTRETIEN
  AUTRE
}

enum NiveauExperience {
  MOINS_1_AN
  UN_A_TROIS_ANS
  TROIS_A_CINQ_ANS
  PLUS_5_ANS
}

enum StatutCandidat {
  DISPONIBLE
  EN_PROCESSUS
  PLACE
}

enum OrigineCandidat {
  LOCAL
  INTERNATIONAL
}

enum TypeContrat {
  TEMPS_PLEIN
  TEMPS_PARTIEL
  TEMPORAIRE
}

enum StatutDemande {
  OUVERTE
  POURVUE
  ANNULEE
}

enum ForfaitComptable {
  MENSUEL
  TRIMESTRIEL
  ANNUEL
}

enum StatutDossier {
  A_JOUR
  EN_RETARD
  EN_TRAITEMENT
}

model Company {
  id            Int         @id @default(autoincrement())
  uuid          String      @unique @default(uuid(7)) @db.Uuid
  type          CompanyType
  slug          String      @unique
  nom           String
  nomCourt      String?
  secteur       String?
  description   String?     @db.Text
  couleurAccent String?
  ordre         Int         @default(0)
  statutSite    StatutSite  @default(ACTIF)
  effectif      Int?
  email         String?
  telephone     String?
  adresse       String?
  linkedinUrl   String?
  facebookUrl   String?
  instagramUrl  String?
  logoKey       String?
  logo          Fichier?    @relation("CompanyLogo", fields: [logoKey], references: [key], onDelete: SetNull)
  heroImageKey  String?
  heroImage     Fichier?    @relation("CompanyHero", fields: [heroImageKey], references: [key], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  users                  User[]
  services               Service[]
  membresEquipe          MembreEquipe[]
  realisations           Realisation[]
  partenaires            Partenaire[]
  messagesContact        MessageContact[]
  reservationsRestaurant ReservationRestaurant[]
  employes               Employe[]
  planningEntries        PlanningEntry[]
  clients                Client[]
  candidats              Candidat[]
  demandesClient         DemandeClient[]
  candidatures           Candidature[]
  fichiers               Fichier[]               @relation("CompanyFichiers")
  sections               SectionContenu[]
  reglagesRestaurant     ReglagesRestaurant?
  affectations           Affectation[]

  @@index([type, ordre])
}

model User {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid(7)) @db.Uuid
  email        String   @unique
  passwordHash String
  nom          String
  role         Role
  companyId    Int?
  company      Company? @relation(fields: [companyId], references: [id])
  actif        Boolean  @default(true)
  // Horloge d'invalidation paresseuse des sessions (lot 6, D9-D11) : une session est valable
  // tant que `loggedInAt >= passwordChangedAt` (null = pas encore de changement = valable).
  passwordChangedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employe Employe?

  @@index([companyId])
}

// Registre de tous les fichiers uploadés : porte le nom original (affichage uniquement),
// le type MIME vérifié, la filiale propriétaire et la visibilité. C'est ce qui permet à
// /api/files/[key] de vérifier l'appartenance à la filiale avant de servir un fichier.
// Pas de champ `uuid` ici : `key` (UUID v4 + extension, généré côté serveur) est déjà
// l'identifiant externe de ce modèle — `id` reste strictement interne (jointures).
model Fichier {
  id          Int               @id @default(autoincrement())
  key         String            @unique
  nomOriginal String
  mimeType    String
  taille      Int
  visibilite  VisibiliteFichier @default(PRIVE)
  companyId   Int?
  company     Company?          @relation("CompanyFichiers", fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  // Relations inverses des FK de clé ajoutées en phase 2 (la clé reste l'identifiant externe).
  companiesLogo  Company[]      @relation("CompanyLogo")
  companiesHero  Company[]      @relation("CompanyHero")
  services       Service[]
  realisations   Realisation[]
  membresEquipe  MembreEquipe[]
  partenaires    Partenaire[]
  candidatsCv    Candidat[]
  candidaturesCv Candidature[]

  @@index([companyId])
}

model Service {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(uuid(7)) @db.Uuid
  companyId   Int
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  titre       String
  description String   @db.Text
  imageKey    String?
  image       Fichier? @relation(fields: [imageKey], references: [key], onDelete: SetNull)
  misEnAvant  Boolean  @default(false)
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, ordre])
}

model MembreEquipe {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid(7)) @db.Uuid
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nom       String
  poste     String
  bio       String?  @db.Text
  photoKey  String?
  photo     Fichier? @relation(fields: [photoKey], references: [key], onDelete: SetNull)
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, ordre])
}

model Realisation {
  id              Int       @id @default(autoincrement())
  uuid            String    @unique @default(uuid(7)) @db.Uuid
  companyId       Int
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  titre           String
  description     String    @db.Text
  imageKey        String?
  image           Fichier?  @relation(fields: [imageKey], references: [key], onDelete: SetNull)
  dateRealisation DateTime? @db.Date
  ordre           Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId, ordre])
}

model Partenaire {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(uuid(7)) @db.Uuid
  companyId    Int
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nom          String
  typeRelation String?
  logoKey      String?
  logo         Fichier? @relation(fields: [logoKey], references: [key], onDelete: SetNull)
  siteUrl      String?
  ordre        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId, ordre])
}

// Contenu éditorial (héros, en-têtes de section, CTA, SEO, textes de formulaire, textes
// légaux, menu, recommandations de l'assistant...) : une ligne par (company, page, clé).
// `donnees` est validé par le schéma zod du type déclaré dans le catalogue versionné
// shared/content/sections/ — jamais de clé créée depuis l'admin (spec §1.2).
model SectionContenu {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid(7)) @db.Uuid
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  page      PageSite
  cle       String   @db.VarChar(64)
  donnees   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, page, cle])
  @@index([companyId, updatedAt])
}

// Réglages du restaurant CDPAA (1:1 avec Company) — consommés par la validation métier des
// réservations côté serveur (colonnes typées plutôt qu'un JSON, pour ne jamais casser
// silencieusement cette validation, spec §1.2).
model ReglagesRestaurant {
  id                     Int      @id @default(autoincrement())
  uuid                   String   @unique @default(uuid(7)) @db.Uuid
  companyId              Int      @unique
  company                Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nom                    String
  adresse                String?
  quartier               String?
  joursOuverture         Int[]
  heureOuverture         String
  heureFermeture         String
  dernierService         String
  pasCreneauMinutes      Int      @default(30)
  capaciteMaxReservation Int      @default(20)
  delaiMinimumHeures     Int      @default(2)
  horizonJours           Int      @default(90)
  updatedAt              DateTime @updatedAt
}

model MessageContact {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique @default(uuid(7)) @db.Uuid
  companyId       Int
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type            TypeMessage   @default(CONTACT)
  nom             String
  email           String
  telephone       String?
  sujet           String?
  message         String        @db.Text
  produitSouhaite String?
  entreprise      String?
  details         Json?
  paysOrigine     String?
  statut          StatutMessage @default(NOUVEAU)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([companyId, statut])
  @@index([companyId, type, createdAt])
}

model ReservationRestaurant {
  id              Int               @id @default(autoincrement())
  uuid            String            @unique @default(uuid(7)) @db.Uuid
  companyId       Int
  company         Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nom             String
  email           String
  telephone       String
  nombrePersonnes Int
  dateReservation DateTime
  notes           String?           @db.Text
  statut          StatutReservation @default(EN_ATTENTE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([companyId, dateReservation])
  @@index([companyId, statut])
}

model Employe {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid(7)) @db.Uuid
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    Int?     @unique
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  nom       String
  poste     String
  email     String?
  telephone String?
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planningEntries PlanningEntry[]

  @@index([companyId])
}

model PlanningEntry {
  id        Int      @id @default(autoincrement())
  uuid      String   @unique @default(uuid(7)) @db.Uuid
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employeId Int
  employe   Employe  @relation(fields: [employeId], references: [id], onDelete: Cascade)
  titre     String?
  lieu      String
  dateDebut DateTime
  dateFin   DateTime
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, dateDebut])
  @@index([employeId])
}

model Client {
  id                  Int          @id @default(autoincrement())
  uuid                String       @unique @default(uuid(7)) @db.Uuid
  companyId           Int
  company             Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nom                 String
  entreprise          String?
  email               String?
  telephone           String?
  statut              StatutClient @default(PROSPECT)
  notes               String?      @db.Text
  dateAjout           DateTime     @default(now())
  derniereInteraction DateTime?

  dossierComptable DossierComptable?

  @@unique([companyId, email])
  @@index([companyId])
}

// Étend Client plutôt qu'un modèle clientsComptables isolé et dupliqué —
// voir PROJECT_STATE.md, "Décisions encore ouvertes", point 2 (à confirmer avec l'utilisateur).
model DossierComptable {
  id              Int               @id @default(autoincrement())
  uuid            String            @unique @default(uuid(7)) @db.Uuid
  clientId        Int               @unique
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  typeDeclaration String?
  forfait         ForfaitComptable?
  statut          StatutDossier     @default(A_JOUR)
  echeance        DateTime?
  documentsKeys   String[]          @default([])
  notes           String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Candidat {
  id             Int             @id @default(autoincrement())
  uuid           String          @unique @default(uuid(7)) @db.Uuid
  companyId      Int
  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  nomComplet              String?
  email                   String?
  telephone               String?
  posteRecherche          String?
  categorie               CategoriePoste
  disponibilite           String?
  statut                  StatutCandidat  @default(DISPONIBLE)
  origine                 OrigineCandidat
  cvKey                   String?
  cv                      Fichier?        @relation(fields: [cvKey], references: [key], onDelete: SetNull)
  notes                   String?         @db.Text
  anonymiseLe             DateTime? // Loi 25 : posé à l'anonymisation du vivier (12 mois, renouvelable)
  consentementRenouveleLe DateTime? // renouvellement : base = COALESCE(consentementRenouveleLe, createdAt)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  candidatures Candidature[]
  affectations Affectation[]

  // Dédoublonnage « Ajouter au vivier » → 409 (une candidature devient un candidat unique par filiale/email).
  // email nullable (anonymisation) : Postgres traite les NULL comme distincts, le vivier reste sans doublon.
  @@unique([companyId, email])
  @@index([companyId, statut])
}

model DemandeClient {
  id                       Int           @id @default(autoincrement())
  uuid                     String        @unique @default(uuid(7)) @db.Uuid
  companyId                Int
  company                  Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  entrepriseCliente        String
  posteRecherche           String
  categorie                CategoriePoste
  posteAutrePrecision      String?
  recrutementInternational Boolean       @default(false)
  contactNom               String
  contactEmail             String
  contactTelephone         String?
  nombrePostes             Int           @default(1)
  dateDebut                DateTime?     @db.Date
  description              String        @db.Text
  publiee                  Boolean       @default(false)
  statut                   StatutDemande @default(OUVERTE)
  titreOffre               String?
  lieu                     String?
  typeContrat              TypeContrat?
  salaire                  String?
  descriptionPublique      String?       @db.Text
  publieeLe                DateTime?
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  candidatures Candidature[]
  affectations Affectation[]

  @@index([companyId, publiee, statut])
}

model Candidature {
  id                  Int               @id @default(autoincrement())
  uuid                String            @unique @default(uuid(7)) @db.Uuid
  companyId           Int
  company             Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  demandeId           Int?
  demande             DemandeClient?    @relation(fields: [demandeId], references: [id], onDelete: SetNull)
  candidatId          Int?
  candidat            Candidat?         @relation(fields: [candidatId], references: [id], onDelete: SetNull)
  nomComplet          String?
  email               String?
  telephone           String?
  adresseComplete     String?
  posteRecherche      String
  posteAutrePrecision String?
  categorie           CategoriePoste
  experience          NiveauExperience?
  pays                String
  message             String?           @db.Text
  cvKey               String?
  cv                  Fichier?          @relation(fields: [cvKey], references: [key], onDelete: Restrict)
  autresDocumentsKeys String[]          @default([])
  statut              StatutCandidature @default(NOUVELLE)
  consentementLe      DateTime
  dateEnvoi           DateTime          @default(now())
  // Loi 25 : réception → 6 mois (rejet) ou 6 mois (jamais traitée) ; retenue → 12 mois renouvelable.
  rejeteLe            DateTime? // posé quand statut → REJETEE (horloge 6 mois), effacé si l'on quitte REJETEE
  retenueLe           DateTime? // posé quand statut → RETENUE (horloge 12 mois) ou renouvellement
  anonymiseLe         DateTime? // posé à l'anonymisation (garde l'écran, cache les PII)
  updatedAt           DateTime          @updatedAt

  @@index([companyId, statut])
  @@index([demandeId])
}

// Rapprochement d'un candidat à une demande cliente (DEC-24) : scopée par filiale comme
// toutes les autres tables (companyId dénormalisé, fixé côté serveur depuis la demande).
model Affectation {
  id              Int           @id @default(autoincrement())
  uuid            String        @unique @default(uuid(7)) @db.Uuid
  companyId       Int
  company         Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidatId      Int
  candidat        Candidat      @relation(fields: [candidatId], references: [id], onDelete: Cascade)
  demandeId       Int
  demande         DemandeClient @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  dateAffectation DateTime      @default(now())

  @@unique([candidatId, demandeId])
  @@index([companyId])
  @@index([demandeId])
}

// Garde-fou des tâches planifiées (cluster) : `claimTaskExecution` verrouille par
// `updateMany` conditionnel sur la ligne de `cle` — 100 % Prisma, jamais de SQL brut.
model TaskExecution {
  id           Int      @id @default(autoincrement())
  cle          String   @unique
  dateDerniere DateTime
  updatedAt    DateTime @updatedAt
}
