# Base de données (Prisma lit DATABASE_URL via prisma.config.ts et server/utils/prisma.ts)
# Le rôle doit avoir CREATEDB en dev : `prisma migrate dev` crée une shadow database.
DATABASE_URL="postgresql://groupe_cd:CHANGE_ME@localhost:5432/groupe_cd?schema=public"

# nuxt-auth-utils — 32+ caractères aléatoires : openssl rand -base64 48
NUXT_SESSION_PASSWORD="CHANGE_ME_min_32_chars"

# Stockage fichiers (driver fs, monté au runtime par server/plugins/storage.ts) — hors de public/
NUXT_UPLOADS_DIR="./storage/uploads"

# Mots de passe des 3 comptes de démo créés par prisma/seed.ts (dev uniquement)
SEED_SUPER_ADMIN_PASSWORD="CHANGE_ME"
SEED_ADMIN_FILIALE_PASSWORD="CHANGE_ME"
SEED_EMPLOYE_PASSWORD="CHANGE_ME"
SEED_DEMO_DATA=true
NUXT_MAIL_TRANSPORT=log
NUXT_MAIL_FROM=
NUXT_MAIL_SMTP_HOST=
NUXT_MAIL_SMTP_PORT=587
NUXT_MAIL_SMTP_SECURE=false
NUXT_MAIL_SMTP_USER=
NUXT_MAIL_SMTP_PASSWORD=
E2E_BASE_URL=
PW_CHROMIUM_PATH=